# Required: DeepSeek API key (used for the chat model, Search API and Fetch API)
DEEPSEEK_API_KEY=

# Optional: chat model name, default deepseek-flash
# DEEPSEEK_MODEL=deepseek-flash

# Optional: API base URL, default https://api.deepseek.com
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional: let the model "think" before answering, default off (faster and cheaper). Setting it to on is several times slower and costs more
# DEEPSEEK_THINKING=off
